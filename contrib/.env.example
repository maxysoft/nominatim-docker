# Copy to contrib/.env and set real values. Never commit the result.
#   openssl rand -base64 24 | tr -d '/+=' 
#
# Password for the PostgreSQL superuser. Used only to provision roles and
# extensions during the first import.
POSTGRES_ADMIN_PASSWORD=change-me-admin

# Password for the unprivileged nominatim and www-data database roles.
# Must not contain ';' — it terminates a field in the Nominatim DSN.
NOMINATIM_PASSWORD=change-me-app
