# Copy to contrib/.env and set real values. Never commit the result.
#   openssl rand -base64 24 | tr -d '/+=' 
#
# Password for the PostgreSQL superuser. Used only to provision roles and
# extensions during the first import.
POSTGRES_ADMIN_PASSWORD=change-me-admin

# Password for the unprivileged nominatim application role, which owns the
# database. Must not contain ';' or '=', which break the Nominatim DSN.
NOMINATIM_PASSWORD=change-me-app

# Password for the read-only www-data role the API connects as. Use a
# different value, or the API role can log in as the owning role. Same
# character rules as above.
NOMINATIM_WEBUSER_PASSWORD=change-me-web
