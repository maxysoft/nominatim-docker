#!/bin/sh
set -eu

docker network create nominatim-net

docker run -d --rm --name postgres --network nominatim-net \
  -e POSTGRES_PASSWORD=very_secure_password \
  -e POSTGRES_USER=postgres \
  -e POSTGRES_DB=nominatim \
  postgis/postgis:18-3.6-alpine@sha256:ffcf0c4b904e41b9779f8098007fb5a9484025319c18c70cf8e1bcebb742b9b7

for _ in $(seq 1 60); do
  if docker exec postgres pg_isready -U postgres >/dev/null 2>&1; then
    echo "PostgreSQL is ready"
    exit 0
  fi
  echo "Waiting for PostgreSQL..."
  sleep 2
done

echo "PostgreSQL never became ready"
docker logs postgres 2>&1 | tail -30
exit 1
