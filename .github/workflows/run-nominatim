#!/bin/sh
# No --rm: the shutdown scenario inspects the exit code and the restart scenario removes the container itself.
set -eu

exec docker run -i --network nominatim-net --shm-size 1g \
  -e POSTGRES_HOST=postgres \
  -e POSTGRES_DB=nominatim \
  -e NOMINATIM_PASSWORD=very_secure_password \
  -e POSTGRES_ADMIN_PASSWORD=very_secure_password \
  -v nominatim-data:/nominatim \
  -p 8080:8080 \
  --name nominatim \
  "$@" \
  "nominatim:$NOMINATIM_VERSION"
